# Spotify for Developers > App settings > Client ID
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Must exactly match a Redirect URI registered in Spotify for Developers.
# Production: use your HTTPS app URL. Local dev: use an explicit loopback IP,
# for example http://127.0.0.1:5173 (never use localhost).
VITE_SPOTIFY_REDIRECT_URI=https://your-deployed-app.example
